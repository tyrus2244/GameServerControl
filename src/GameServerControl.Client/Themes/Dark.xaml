<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Palette — matched to the TK-ECLIPSE logo: red play-mark on near-black with red bevel. -->
    <!-- Backgrounds get a slight red-warm tint so the whole app feels of-a-piece with the icon. -->
    <Color x:Key="Bg0">#FF0A0405</Color>   <!-- deepest black (page bg) -->
    <Color x:Key="Bg1">#FF15090B</Color>   <!-- card / panel bg -->
    <Color x:Key="Bg2">#FF1C1014</Color>   <!-- input / control bg -->
    <Color x:Key="Bg3">#FF2A1318</Color>   <!-- hover / pill bg -->
    <Color x:Key="Border">#FF3D1A20</Color>
    <Color x:Key="Text">#FFF0DCDE</Color>
    <Color x:Key="TextDim">#FF8A6B70</Color>
    <Color x:Key="Accent">#FFDC1E2D</Color>    <!-- brand crimson — matches logo triangle -->
    <Color x:Key="AccentDim">#FF7A0E18</Color> <!-- dark crimson for hover/pressed -->
    <!-- Status colors — diverged from accent so "UP" reads instantly without clashing. -->
    <Color x:Key="Good">#FFFF6B3D</Color>      <!-- bright red-orange = powered/hot -->
    <Color x:Key="Bad">#FF6F575A</Color>       <!-- desaturated grey-red = offline -->
    <Color x:Key="Warn">#FFD29922</Color>
    <Color x:Key="Info">#FFE5B0B4</Color>      <!-- pale warm rose for info pills -->
    <Color x:Key="Watermark">#FF5A2E34</Color> <!-- dim signature stamp -->
    <Color x:Key="WatermarkBright">#FFAE5560</Color>

    <SolidColorBrush x:Key="BgBrush0" Color="{StaticResource Bg0}"/>
    <SolidColorBrush x:Key="BgBrush1" Color="{StaticResource Bg1}"/>
    <SolidColorBrush x:Key="BgBrush2" Color="{StaticResource Bg2}"/>
    <SolidColorBrush x:Key="BgBrush3" Color="{StaticResource Bg3}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource Good}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource Bad}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="WatermarkBrush" Color="{StaticResource Watermark}"/>
    <SolidColorBrush x:Key="WatermarkBrightBrush" Color="{StaticResource WatermarkBright}"/>

    <!-- Defaults -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource BgBrush0}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgBrush2}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <!-- Card -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgBrush1}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Action button -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgBrush3}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource BadBrush}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BadBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch (CheckBox restyled) -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="track" Grid.Column="0" Width="48" Height="26"
                                CornerRadius="13" Background="{StaticResource BgBrush3}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border x:Name="thumb" Width="20" Height="20" CornerRadius="10"
                                    Background="{StaticResource TextBrush}"
                                    HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status pill -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Background" Value="{StaticResource BgBrush3}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
