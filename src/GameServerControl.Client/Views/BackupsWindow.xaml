<Window x:Class="GameServerControl.Client.Views.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backups"
        Width="820" Height="560"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" Text="Backups" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Server-side save backups. Restoring stops the server, snapshots the current saves as a 'pre-restore' safety backup, then unpacks the chosen archive."
                       Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshBtn" Content="↻ Refresh" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
            <Button x:Name="CreateBtn" Content="⏷ New Backup Now" Style="{StaticResource ActionButton}" Click="Create_Click" Margin="6,0,0,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextDimBrush}"/>
        </StackPanel>

        <!-- Backups list -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ListView x:Name="BackupsList" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="320" DisplayMemberBinding="{Binding CheckpointName}"/>
                        <GridViewColumn Header="Created" Width="200" DisplayMemberBinding="{Binding CreatedLocal}"/>
                        <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                        <GridViewColumn Header="" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="↶ Restore" Style="{StaticResource ActionButton}"
                                                Tag="{Binding CheckpointName}" Click="Restore_Click"/>
                                        <Button Content="🗑" Style="{StaticResource DangerButton}"
                                                Tag="{Binding CheckpointName}" Click="Delete_Click" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" x:Name="EmptyText"
                   Text="No backups yet — click 'New Backup Now' to create one."
                   Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}"
                   Visibility="Collapsed" HorizontalAlignment="Center"/>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
