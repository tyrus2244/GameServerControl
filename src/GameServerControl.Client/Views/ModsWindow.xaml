<Window x:Class="GameServerControl.Client.Views.ModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameServerControl.Client.ViewModels"
        Title="Mods"
        Width="820" Height="600"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" Text="Server-side mods" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Manage BepInEx plugins for this server. Restart the server after installing/removing for changes to take effect."
                       Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="ModsFolderText" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Install from URL -->
        <Border Grid.Row="1" Background="{StaticResource BgBrush1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Install from URL" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Paste a Thunderstore 'Manual Download' link or any direct .zip URL." FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="UrlBox" Padding="6" Background="{StaticResource BgBrush2}" Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    <Button Grid.Column="1" Content="Install" Style="{StaticResource ActionButton}" Click="Install_Click" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="WarnText"
                           Text="⚠ Server-side-only mods affect the server alone. If a mod also changes the game (visual/balance/items), every player needs to install it too — check the mod's docs."
                           FontSize="11" Foreground="#dca74a" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Installed list -->
        <Border Grid.Row="2" Background="{StaticResource BgBrush1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ModList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgBrush0}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Version, StringFormat=' v{0}'}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="6,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ModId}" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding SizeKb, Mode=OneWay, StringFormat={}{0} KB}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding InstalledAtLabel, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Uninstall"
                                                Style="{StaticResource ActionButton}"
                                                VerticalAlignment="Center"
                                                Click="Uninstall_Click"
                                                Tag="{Binding ModId}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText"
                           Text="No mods installed yet. Paste a URL above to install one."
                           Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,10,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
            <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
