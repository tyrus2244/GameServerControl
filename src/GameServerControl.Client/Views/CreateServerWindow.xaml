<Window x:Class="GameServerControl.Client.Views.CreateServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameServerControl.Client.ViewModels"
        Title="Create Server"
        Width="780" Height="620"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / step indicator -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🚀 Create Server" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="StepSubtitle" Foreground="{StaticResource TextDimBrush}"
                       Text="Pick a game, choose where to install it, and we'll do the rest."
                       Margin="0,4,0,8" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Step1Pill" Style="{StaticResource StatusPill}" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="1 · Pick a game" FontSize="11" FontWeight="Bold"/>
                </Border>
                <Border x:Name="Step2Pill" Style="{StaticResource StatusPill}" Margin="8,0,0,0">
                    <TextBlock Text="2 · Choose location" FontSize="11" FontWeight="Bold"/>
                </Border>
                <Border x:Name="Step3Pill" Style="{StaticResource StatusPill}" Margin="8,0,0,0">
                    <TextBlock Text="3 · Install + watch progress" FontSize="11" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Body — only one panel visible at a time -->
        <Grid Grid.Row="1">
            <!-- ===== STEP 1 ===== -->
            <Border x:Name="Step1Panel" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="GameList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgBrush2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="14" Margin="0,0,0,8"
                                        MouseLeftButtonUp="GameRow_Click" Cursor="Hand" Tag="{Binding Key}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="32" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0">
                                                <Run Text="Steam App ID:"/>
                                                <Run Text="{Binding SteamAppId, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono"/>
                                                <Run Text=" · est. download:"/>
                                                <Run Text="{Binding EstimatedSize, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="❯" FontSize="16" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ===== STEP 2 ===== -->
            <Border x:Name="Step2Panel" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="Step2GameHeader" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Display name" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="DisplayNameBox" Text="My Game Server"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ID (slug)" VerticalAlignment="Center"/>
                            <TextBlock Text="lowercase, dashes" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="IdBox" FontFamily="Consolas, Cascadia Mono"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Install location" VerticalAlignment="Center"/>
                            <TextBlock Text="where the server files land" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="InstallPathBox" FontFamily="Consolas, Cascadia Mono"/>
                        <Button Grid.Column="2" Content="📂" Style="{StaticResource ActionButton}"
                                Click="Browse_Click" Margin="8,0,0,0" ToolTip="Browse for folder"/>
                    </Grid>

                    <Border Background="{StaticResource BgBrush2}" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="📋 Preview" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="PreviewExe" FontSize="11" FontFamily="Consolas, Cascadia Mono" Margin="0,6,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PreviewArgs" FontSize="11" FontFamily="Consolas, Cascadia Mono" Margin="0,2,0,0" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="Step2Error" Foreground="{StaticResource BadBrush}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ===== STEP 3 ===== -->
            <Border x:Name="Step3Panel" Style="{StaticResource Card}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="Step3Header" FontSize="16" FontWeight="SemiBold"
                               Text="SteamCMD is running…"/>
                    <ProgressBar Grid.Row="1" x:Name="InstallProgressBar" Height="14" Margin="0,12,0,12"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush3}"
                                 IsIndeterminate="True"/>
                    <Border Grid.Row="2" Background="{StaticResource BgBrush0}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="10">
                            <TextBlock x:Name="InstallLog" FontFamily="Consolas, Cascadia Mono" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDimBrush}"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Grid.Row="3" x:Name="Step3Status" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BackBtn" Content="← Back" Style="{StaticResource ActionButton}" Click="Back_Click" Visibility="Collapsed"/>
            <Button x:Name="NextBtn" Content="Next →" Style="{StaticResource ActionButton}" Click="Next_Click" Visibility="Collapsed"/>
            <Button x:Name="InstallBtn" Content="⬇ Install" Style="{StaticResource ActionButton}" Click="Install_Click" Visibility="Collapsed"
                    Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
            <Button x:Name="DoneBtn" Content="Done" Style="{StaticResource ActionButton}" Click="Done_Click" Visibility="Collapsed"
                    Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
            <Button Content="Cancel" Style="{StaticResource ActionButton}" Click="Cancel_Click" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
