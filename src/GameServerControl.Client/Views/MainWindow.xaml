<Window x:Class="GameServerControl.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameServerControl.Client.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Game Server Control"
        Width="1100" Height="720"
        Icon="pack://application:,,,/Assets/logo.ico"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Game Server Control" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding AgentUrl, StringFormat=' · {0}'}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StatusPill}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource BadBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource GoodBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionLabel}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="🔍 Discover" Style="{StaticResource ActionButton}" Command="{Binding DiscoverServersCommand}" ToolTip="Auto-detect installed dedicated servers"/>
                    <Button Content="+ Add server" Style="{StaticResource ActionButton}" Command="{Binding AddServerCommand}"/>
                    <Button Content="Refresh" Style="{StaticResource ActionButton}" Command="{Binding RefreshAllCommand}"/>
                    <Button Content="Reconnect" Style="{StaticResource ActionButton}" Command="{Binding ReconnectCommand}"/>
                    <Button Content="Settings" Style="{StaticResource ActionButton}" Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Server list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Title row -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GameIcon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GameType, StringFormat=' · {0}'}" Foreground="{StaticResource TextDimBrush}" Margin="6,2,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding HostingLabel}" Foreground="{StaticResource TextDimBrush}"/>
                                        <Border Style="{StaticResource StatusPill}" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding VmBadgeColor}"/>
                                                <TextBlock Text="{Binding VmBadge}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding ProcBadgeColor}"/>
                                                <TextBlock Text="{Binding ProcBadge}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0"
                                                Visibility="{Binding HasCpuRam, Converter={x:Static vm:BoolVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding CpuRamText}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0"
                                                Visibility="{Binding HasInviteCode, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"
                                                Background="{StaticResource AccentDimBrush}"
                                                BorderBrush="{StaticResource AccentBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔗 INVITE " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding InviteCode}" FontSize="11" FontWeight="Bold" FontFamily="Consolas, Cascadia Mono"/>
                                                <Button Content="📋" Padding="4,0" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource TextBrush}" Cursor="Hand"
                                                        Click="CopyInvite_Click" Tag="{Binding InviteCode}"
                                                        ToolTip="Copy invite code"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Toggle + autostart -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                                    <CheckBox Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding IsOn, Mode=OneWay}"
                                              IsEnabled="{Binding IsBusy, Converter={x:Static vm:NotBoolConverter.Instance}}"
                                              VerticalAlignment="Center"
                                              Click="ToggleClicked"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right"
                                                Visibility="{Binding HasScheduledTask, Converter={x:Static vm:BoolVisibilityConverter.Instance}}">
                                        <TextBlock Text="Autostart on boot" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <CheckBox IsChecked="{Binding IsAutostartEnabled, Mode=OneWay}"
                                                  IsEnabled="{Binding IsAutostartLoading, Converter={x:Static vm:NotBoolConverter.Instance}}"
                                                  VerticalAlignment="Center"
                                                  Click="AutostartClicked"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Buttons -->
                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Content="▶ Start" Style="{StaticResource ActionButton}" Command="{Binding StartCommand}"/>
                                        <Button Content="■ Stop" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}"/>
                                        <Button Content="↻ Restart" Style="{StaticResource ActionButton}" Command="{Binding RestartCommand}"/>
                                        <Button Content="⏷ Backup" Style="{StaticResource ActionButton}" Command="{Binding BackupCommand}"/>
                                        <Button Content="⤓ Update" Style="{StaticResource ActionButton}" Command="{Binding UpdateCommand}"/>
                                        <Button Content="⚙ Configure" Style="{StaticResource ActionButton}" Command="{Binding ConfigureCommand}"/>
                                        <Button Content="💬 Console" Style="{StaticResource ActionButton}" Command="{Binding ConsoleCommand}"/>
                                        <Button Content="📜 Log" Style="{StaticResource ActionButton}" Command="{Binding LogCommand}"/>
                                        <Button Content="🧩 Mods" Style="{StaticResource ActionButton}" Command="{Binding ModsCommand}" ToolTip="Manage server-side mods (BepInEx plugins, etc.)"/>
                                        <Button Content="✓ Apply" Style="{StaticResource ActionButton}" Command="{Binding ApplyConfigCommand}"/>
                                        <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="12,0,0,0" VerticalAlignment="Center"
                                                     Visibility="{Binding IsBusy, Converter={x:Static vm:BoolVisibilityConverter.Instance}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="✎ Edit"   Style="{StaticResource ActionButton}" Command="{Binding EditCommand}"/>
                                        <Button Content="🗑 Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Log pane -->
        <Border Grid.Row="2" Background="{StaticResource BgBrush1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="20,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Activity" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                </Border>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Toasts}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="20,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
