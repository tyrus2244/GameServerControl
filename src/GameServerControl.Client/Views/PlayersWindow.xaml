<Window x:Class="GameServerControl.Client.Views.PlayersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Players"
        Width="640" Height="540"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" Text="👥 Players" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Live player list via RCON. Auto-refreshes every 10s while open. Kick / ban / broadcast in two clicks."
                       Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshBtn" Content="↻ Refresh" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
            <CheckBox x:Name="AutoBox" Content="Auto-refresh" IsChecked="True" VerticalAlignment="Center"
                      Margin="14,0,0,0" Foreground="{StaticResource TextBrush}"
                      ToolTip="Refresh every 10s while the window is open"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource TextDimBrush}"/>
        </StackPanel>

        <!-- Player list -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <ListView x:Name="PlayersList" Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgBrush2}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0">
                                            <Run Text="Steam:"/>
                                            <Run Text="{Binding SteamId, Mode=OneWay}" FontFamily="Consolas, Cascadia Mono"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✕ Kick" Style="{StaticResource ActionButton}" Tag="{Binding SteamId}" Click="Kick_Click"/>
                                        <Button Content="🚫 Ban" Style="{StaticResource DangerButton}" Tag="{Binding SteamId}" Click="Ban_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText"
                           Text="No players online."
                           Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Broadcast bar -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📢 Broadcast" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox  Grid.Column="1" x:Name="BroadcastBox" Padding="6,4"
                          ToolTip="Sent to every connected player"/>
                <Button   Grid.Column="2" Content="Send" Style="{StaticResource ActionButton}"
                          Click="Broadcast_Click" Margin="8,0,0,0" IsDefault="True"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
