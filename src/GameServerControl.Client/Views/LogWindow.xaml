<Window x:Class="GameServerControl.Client.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log tail"
        Width="1100" Height="640"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="PathText" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <ListBox x:Name="Lines" Grid.Row="1"
                 Background="{StaticResource BgBrush1}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 FontFamily="Consolas, Cascadia Mono" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,1"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="ClearBtn"  Content="Clear" Style="{StaticResource ActionButton}" Click="Clear_Click"/>
            <Button x:Name="CloseBtn"  Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
