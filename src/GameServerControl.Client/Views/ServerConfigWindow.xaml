<Window x:Class="GameServerControl.Client.Views.ServerConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameServerControl.Client.ViewModels"
        xmlns:shared="clr-namespace:GameServerControl.Shared;assembly=GameServerControl.Shared"
        Title="Configure server"
        Width="720" Height="780"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Templates per field type -->
        <DataTemplate x:Key="TextTpl">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,4,12,0">
                    <TextBlock Text="{Binding Label}"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MultilineTpl">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,4,12,0">
                    <TextBlock Text="{Binding Label}"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ToggleTpl">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,2,12,0">
                    <TextBlock Text="{Binding Label}"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BoolValue}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ChoiceTpl">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,4,12,0">
                    <TextBlock Text="{Binding Label}"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}"
                          Background="{StaticResource BgBrush2}" Foreground="{StaticResource TextBrush}" Padding="6,4"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NumberTpl">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,4,12,0">
                    <TextBlock Text="{Binding Label}"/>
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Value="{Binding NumberValue}"
                            Minimum="{Binding Min}" Maximum="{Binding Max}"
                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding NumberValue, StringFormat={}{0:0.###}, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <vm:ConfigFieldTemplateSelector x:Key="FieldTplSel"
            TextTpl="{StaticResource TextTpl}"
            MultilineTpl="{StaticResource MultilineTpl}"
            ToggleTpl="{StaticResource ToggleTpl}"
            ChoiceTpl="{StaticResource ChoiceTpl}"
            NumberTpl="{StaticResource NumberTpl}"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding HeaderText}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Changes are written to the server's config. Some take effect on next restart."
                       Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgBrush1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" Foreground="{StaticResource InfoBrush}"/>
                                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplateSelector="{StaticResource FieldTplSel}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Style="{StaticResource ActionButton}" Click="Cancel_Click"/>
            <Button Content="Apply" Style="{StaticResource ActionButton}" Click="Apply_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
