<Window x:Class="GameServerControl.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Settings"
        Width="520" Height="280"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Agent URL" Margin="0,0,0,4"/>
        <TextBox Grid.Row="1" x:Name="UrlBox" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Text="API Token" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" x:Name="TokenBox" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                   Text="Tip: bind the agent to a Tailscale IP and put that URL here (e.g. http://100.x.y.z:5099). The token must match Agent:ApiToken in the agent's appsettings.json."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource ActionButton}" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource ActionButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
