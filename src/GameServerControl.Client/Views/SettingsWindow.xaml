<Window x:Class="GameServerControl.Client.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Settings"
        Width="720" Height="500"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Agents" FontSize="18" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0">
                Add one or more agents. The client connects to all of them and merges their server lists into
                a single dashboard. Each row is a separate machine — set a friendly nickname so you can tell
                them apart on the cards.
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AgentsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgBrush1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nickname" Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="URL" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="8,0,0,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="API Token" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="8,0,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" FontFamily="Consolas, Cascadia Mono"/>
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" FontFamily="Consolas, Cascadia Mono"/>
                                <Button Grid.Row="1" Grid.Column="3" Content="✕" Click="Remove_Click" Tag="{Binding Id}" Margin="8,0,0,0" Style="{StaticResource DangerButton}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="+ Add agent" Style="{StaticResource ActionButton}" Click="Add_Click"/>
            <TextBlock Foreground="{StaticResource TextDimBrush}" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="Tip: bind each agent to a Tailscale IP. Tokens come from the agent's tokens.json or appsettings.json."/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource ActionButton}" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource ActionButton}" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
