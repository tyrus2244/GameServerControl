<Window x:Class="GameServerControl.Client.Views.RconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameServerControl.Client.ViewModels"
        xmlns:shared="clr-namespace:GameServerControl.Shared;assembly=GameServerControl.Shared"
        Title="RCON Console"
        Width="1000" Height="640"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Text="{Binding Server.Name, StringFormat='RCON Console — {0}'}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Players (left) -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Players" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,8"/>
                <Button Grid.Row="1" Content="↻ Refresh" Style="{StaticResource ActionButton}"
                        Command="{Binding RefreshPlayersCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}"
                         Background="{StaticResource BgBrush2}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SteamId, StringFormat='Steam: {0}'}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="✕ Kick" Style="{StaticResource DangerButton}" Command="{Binding KickSelectedCommand}"/>
                    <Button Content="🚫 Ban" Style="{StaticResource DangerButton}" Command="{Binding BanSelectedCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right column: commands + log -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Commands -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Commands" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Broadcast" VerticalAlignment="Center"/>
                        <TextBox  Grid.Column="1" Text="{Binding BroadcastText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button   Grid.Column="2" Content="📢 Send" Style="{StaticResource ActionButton}"
                                  Command="{Binding BroadcastCommand}" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Shutdown in (s)" VerticalAlignment="Center"/>
                        <TextBox  Grid.Column="1" Text="{Binding ShutdownSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <TextBox  Grid.Column="2" Text="{Binding ShutdownMessage, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button   Grid.Column="3" Content="⚠ Shutdown" Style="{StaticResource DangerButton}"
                                  Command="{Binding ShutdownCommand}" Margin="8,0,0,0"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="💾 Save World" Style="{StaticResource ActionButton}" Command="{Binding SaveWorldCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Log -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Output" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Log}"
                             Background="{StaticResource BgBrush2}" Foreground="{StaticResource TextBrush}"
                             FontFamily="Consolas, Cascadia Mono" FontSize="12"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Cascadia Mono" Padding="6,4"/>
                        <Button Grid.Column="1" Content="▶ Run" Style="{StaticResource ActionButton}"
                                Command="{Binding SendRawCommand}" Margin="8,0,0,0" IsDefault="True"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
