<Window x:Class="GameServerControl.Client.Views.DiscoverServersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GameServerControl.Client.ViewModels"
        Title="Discover servers"
        Width="780" Height="560"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Detected dedicated servers" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Scans your Steam libraries (via libraryfolders.vdf) and common SteamCMD paths."
                       Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}"/>
        </StackPanel>

        <!-- List -->
        <Border Grid.Row="1" Background="{StaticResource BgBrush1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgBrush0}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                                            <Border Margin="10,2,0,0" Padding="6,1" CornerRadius="3"
                                                    Background="{StaticResource BgBrush2}">
                                                <TextBlock Text="{Binding Source}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                            </Border>
                                            <Border Margin="6,2,0,0" Padding="6,1" CornerRadius="3"
                                                    Background="#4A2A0D" Visibility="{Binding AlreadyConfigured, Converter={x:Static vm:BoolVisibilityConverter.Instance}}">
                                                <TextBlock Text="already added" FontSize="11" Foreground="#D29922"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InstallPath}" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0">
                                            <Run Text="App "/>
                                            <Run Text="{Binding SteamAppId, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding ExePath, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="+ Add"
                                            Style="{StaticResource ActionButton}"
                                            VerticalAlignment="Center"
                                            Click="Add_Click"
                                            Tag="{Binding}"
                                            IsEnabled="{Binding AlreadyConfigured, Converter={x:Static vm:NotBoolConverter.Instance}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Libraries scanned -->
        <Expander Grid.Row="2" Header="Locations scanned" Margin="0,10,0,0" Foreground="{StaticResource TextDimBrush}">
            <ItemsControl x:Name="LibrariesList" Margin="20,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Refresh" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
            <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
