<Window x:Class="GameServerControl.Client.Views.TokensWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Tokens"
        Width="780" Height="560"
        Background="{StaticResource BgBrush0}"
        Foreground="{StaticResource TextBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="API Tokens" FontSize="20" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0">
                Multi-user bearer tokens with role-based access. Read-only tokens can view dashboards and logs but
                cannot start/stop servers, change configs, or install mods. Token values are shown ONCE on creation;
                listings only show the prefix.
            </TextBlock>
        </StackPanel>

        <!-- Create form -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="ID (slug)" Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                    <TextBox x:Name="IdBox" FontFamily="Consolas, Cascadia Mono"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Display name" Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                    <TextBox x:Name="NameBox"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Role" Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                    <ComboBox x:Name="RoleCombo" SelectedIndex="0">
                        <ComboBoxItem Content="Admin"/>
                        <ComboBoxItem Content="ReadOnly"/>
                    </ComboBox>
                </StackPanel>
                <Button Grid.Column="3" Content="+ Create" Style="{StaticResource ActionButton}"
                        Click="Create_Click" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- Tokens list -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ListView x:Name="TokensList" Background="Transparent" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" Width="140" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Role" Width="80" DisplayMemberBinding="{Binding Role}"/>
                        <GridViewColumn Header="Token prefix" Width="120" DisplayMemberBinding="{Binding Token}"/>
                        <GridViewColumn Header="Created" Width="120" DisplayMemberBinding="{Binding CreatedLocal}"/>
                        <GridViewColumn Header="" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑 Revoke" Style="{StaticResource DangerButton}"
                                            Tag="{Binding Id}" Click="Revoke_Click"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
            <Button Content="Close" Style="{StaticResource ActionButton}" Click="Close_Click" Margin="6,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
